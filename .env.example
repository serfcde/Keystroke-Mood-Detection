# Copy this file to .env and fill in a key. Never commit .env.

# Which LLM writes the explanations: groq (default, free tier) | anthropic | template (no LLM)
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any chat model listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Only needed if LLM_PROVIDER=anthropic (requires API credits)
ANTHROPIC_API_KEY=
